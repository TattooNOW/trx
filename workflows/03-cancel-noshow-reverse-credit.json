      "id": "get-store-credits",
      "name": "Get Store Credits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -60],
      "credentials": {
        "httpHeaderAuth": {
          "id": "lightspeed-token",
