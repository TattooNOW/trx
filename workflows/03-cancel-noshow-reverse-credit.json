    {
      "parameters": {
        "jsCode": "// Find the matching store credit by notes field\nconst credits = $json.data || [];\nconst appointmentData = $('Validate & Extract').first().json;\n\n// Look for the deposit matching the appointment date / artist\nconst matchingCredit = credits.find(c => {\n  if (c.type !== 'ISSUE') return false;\n  const notes = (c.notes || '').toLowerCase();\n  // Match on appointment date or artist name\n  const dateMatch = appointmentData.appointmentDate && notes.includes(appointmentData.appointmentDate.split('T')[0]);\n  const artistMatch = appointmentData.artistName && notes.includes(appointmentData.artistName.toLowerCase());\n  return dateMatch || artistMatch;\n});\n\nif (!matchingCredit) {\n  // No matching credit found — still proceed but flag it\n  return [{\n    json: {\n      ...appointmentData,\n      creditFound: false,\n      creditId: null,\n      creditAmount: appointmentData.depositAmount,\n      customerId: $('Find LS Customer').first().json.data[0].id\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...appointmentData,\n    creditFound: true,\n    creditId: matchingCredit.id,\n    creditAmount: parseFloat(matchingCredit.amount),\n    customerId: $('Find LS Customer').first().json.data[0].id\n  }\n}];"
      },
      "id": "find-matching-credit",
      "name": "Find Matching Credit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, -60]
    },
    {
      "parameters": {
