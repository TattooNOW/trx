{
  "name": "WF3 — Cancel/No-Show → Reverse Store Credit",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ghl-appointment-cancel",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook-trigger",
      "name": "GHL Appointment Status Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "ghl-cancel-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate appointment cancellation/no-show data\nconst body = $json.body || $json;\n\nconst contactId = body.contact_id || body.contactId;\nconst contactEmail = body.contact_email || body.email || (body.contact && body.contact.email);\nconst appointmentDate = body.startTime || body.appointment_date || body.selectedTimeslot;\nconst cancellationTimestamp = body.dateUpdated || body.updatedAt || new Date().toISOString();\nconst status = (body.status || body.appointmentStatus || '').toLowerCase();\nconst depositAmount = parseFloat(body.deposit_amount || body.customFields?.deposit_amount || 0);\nconst artistName = body.calendarName || body.artist_name || '';\nconst appointmentType = body.title || body.appointment_type || 'Appointment';\n\nif (!contactEmail) {\n  throw new Error('Missing contact email in appointment webhook');\n}\n\nif (status !== 'cancelled' && status !== 'no_show' && status !== 'no-show' && status !== 'noshow') {\n  // Not a cancellation or no-show — skip\n  return [];\n}\n\n// Calculate hours between cancellation and appointment\nconst appointmentTime = new Date(appointmentDate).getTime();\nconst cancelTime = new Date(cancellationTimestamp).getTime();\nconst hoursDiff = (appointmentTime - cancelTime) / (1000 * 60 * 60);\nconst isNoShow = status === 'no_show' || status === 'no-show' || status === 'noshow';\nconst isLateCancel = !isNoShow && hoursDiff < 48;\nconst isFullRefund = !isNoShow && hoursDiff >= 48;\n\nreturn [{\n  json: {\n    contactId,\n    contactEmail,\n    appointmentDate,\n    cancellationTimestamp,\n    status,\n    depositAmount,\n    artistName,\n    appointmentType,\n    hoursDiff: Math.round(hoursDiff * 10) / 10,\n    isNoShow,\n    isLateCancel,\n    isFullRefund,\n    path: isFullRefund ? 'refund' : 'forfeit'\n  }\n}];"
      },
      "id": "validate-extract",
      "name": "Validate & Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
