    {
      "parameters": {
        "jsCode": "// Validate GHL search results — only accept exact email match\nconst inputEmail = $('Extract Input').first().json.email;\nconst searchResult = $json;\nconst contacts = searchResult.contacts || [];\n\n// GHL search is fuzzy — verify email matches exactly\nconst exactMatch = contacts.find(c =>\n  c.email && c.email.toLowerCase().trim() === inputEmail\n);\n\nreturn [{ json: { found: !!exactMatch, contact: exactMatch || null } }];"
      },
