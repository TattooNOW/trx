        "specifyBody": "json",
        "jsonBody": "={\n  \"locationId\": \"n3G3ccCrPjsSH9bGlfIQ\",\n  \"query\": \"{{ $('Extract Input').first().json.email }}\",\n  \"pageLimit\": 1\n}"
      },
      "id": "ghl-search",
      "name": "Search GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
