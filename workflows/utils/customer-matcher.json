    {
      "parameters": {
        "jsCode": "// Extract and validate input from calling workflow\nconst item = $input.first().json;\n\n// Support both naming conventions from callers\nconst email = (item.email || item.customerEmail || '').trim().toLowerCase();\nconst firstName = (item.firstName || item.customerFirstName || item.first_name || '').trim();\nconst lastName = (item.lastName || item.customerLastName || item.last_name || '').trim();\nconst phone = (item.phone || item.customerPhone || '').trim();\n\nif (!email) {\n  throw new Error('Customer Matcher requires an email address — received: ' + JSON.stringify(Object.keys(item)));\n}\n\nreturn [{ json: { email, firstName, lastName, phone } }];"
      },
