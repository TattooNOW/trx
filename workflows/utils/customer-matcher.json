      "id": "ghl-create",
      "name": "Create GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ghl-pit-token",
