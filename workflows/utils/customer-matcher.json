          "name": "GHL TRX"
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Validate LS search results — only accept exact email match\nconst inputEmail = $('Extract Input').first().json.email;\nconst searchResult = $json;\nconst customers = (searchResult.data || []);\n\n// LS search can return fuzzy matches — verify email matches exactly\nconst exactMatch = customers.find(c =>\n  c.email && c.email.toLowerCase().trim() === inputEmail\n);\n\nreturn [{ json: { found: !!exactMatch, customer: exactMatch || null } }];"
      },
