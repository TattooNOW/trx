    {
      "parameters": {
        "jsCode": "// Gather results from all branches\nconst input = $('Extract Input').first().json;\n\n// Lightspeed result\nlet lightspeed_customer_id = null;\nlet found_in_ls = false;\n\ntry {\n  const lsValidate = $('Validate LS Match').first().json;\n  if (lsValidate.found && lsValidate.customer) {\n    lightspeed_customer_id = lsValidate.customer.id;\n    found_in_ls = true;\n  }\n} catch (e) {}\n\nif (!found_in_ls) {\n  try {\n    const lsCreate = $('Create LS Customer').first().json;\n    if (lsCreate.data && lsCreate.data.id) {\n      lightspeed_customer_id = lsCreate.data.id;\n    } else if (lsCreate.id) {\n      lightspeed_customer_id = lsCreate.id;\n    }\n  } catch (e) {}\n}\n\n// GHL result\nlet ghl_contact_id = null;\nlet found_in_ghl = false;\n\ntry {\n  const ghlValidate = $('Validate GHL Match').first().json;\n  if (ghlValidate.found && ghlValidate.contact) {\n    ghl_contact_id = ghlValidate.contact.id;\n    found_in_ghl = true;\n  }\n} catch (e) {}\n\nif (!found_in_ghl) {\n  try {\n    const ghlCreate = $('Create GHL Contact').first().json;\n    if (ghlCreate.contact && ghlCreate.contact.id) {\n      ghl_contact_id = ghlCreate.contact.id;\n    }\n  } catch (e) {}\n}\n\nreturn [{\n  json: {\n    ghl_contact_id,\n    lightspeed_customer_id,\n    found_in_ghl,\n    found_in_ls,\n    email: input.email\n  }\n}];"
      },
