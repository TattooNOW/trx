{
  "name": "Util \u2014 Error Logger",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Sub-Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{ json: {\n  workflowName: item.workflowName || 'Unknown',\n  errorMessage: item.errorMessage || 'No message',\n  payload: JSON.stringify(item.payload || {}),\n  timestamp: new Date().toISOString(),\n  severity: item.severity || 'error'\n} }];"
      },
      "id": "format-error",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "gabe@tattoonow.com",
        "toEmail": "gabe@tattoonow.com",
        "subject": "=TRX n8n Error: {{ $json.workflowName }}",
        "emailType": "text",
        "message": "=Workflow: {{ $json.workflowName }}\nTime: {{ $json.timestamp }}\nSeverity: {{ $json.severity }}\n\nError: {{ $json.errorMessage }}\n\nPayload:\n{{ $json.payload }}"
      },
      "id": "send-email",
      "name": "Send Error Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        440,
        0
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { logged: true } }];"
      },
      "id": "confirm",
      "name": "Confirm Logged",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Sub-Workflow Trigger": {
      "main": [
        [
          {
            "node": "Format Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error": {
      "main": [
        [
          {
            "node": "Send Error Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Error Email": {
      "main": [
        [
          {
            "node": "Confirm Logged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
