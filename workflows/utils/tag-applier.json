{
  "name": "Util — Tag Applier",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger",
      "name": "Sub-Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst contactId = item.contactId || '';\nif (!contactId) {\n  throw new Error('Tag Applier: missing contactId — received: ' + JSON.stringify(Object.keys(item)));\n}\n\n// Tags: accept array or JSON string\nlet tags = item.tags || [];\nif (typeof tags === 'string') {\n  try { tags = JSON.parse(tags); } catch (e) { tags = [tags]; }\n}\n\n// Custom fields: array of { key, field_value }\nconst customFields = item.customFields || [];\n\n// Note: optional string\nconst note = item.note || '';\n\nreturn [{ json: {\n  contactId,\n  tags,\n  hasTags: tags.length > 0,\n  customFields,\n  hasCustomFields: customFields.length > 0,\n  note,\n  hasNote: note.length > 0\n} }];"
      },
      "id": "extract-input",
      "name": "Extract Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-tags",
              "leftValue": "={{ $json.hasTags }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-tags",
      "name": "Has Tags?",
