        "url": "=https://services.leadconnectorhq.com/contacts/{{ $('Extract Input').first().json.contactId }}/tags",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tags: $('Extract Input').first().json.tags }) }}",
        "options": {
          "response": {
