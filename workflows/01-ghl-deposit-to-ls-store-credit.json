{
  "name": "WF1 — GHL Deposit → LS Store Credit",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ghl-deposit",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook-trigger",
      "name": "GHL Payment Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "ghl-deposit-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Validate required fields from GHL payment webhook\nconst body = $json.body;\n\nconst contactId = body.contact_id || body.contactId;\nconst contactEmail = body.contact_email || body.email || (body.contact && body.contact.email);\nconst paymentAmount = body.amount || body.payment_amount;\nconst paymentId = body.payment_id || body.id || body.charge_id;\nconst artistName = body.artist_name || body.calendarName || '';\nconst appointmentDate = body.appointment_date || body.startTime || '';\n\nif (!contactEmail) {\n  throw new Error('Missing contact email in payment webhook payload');\n}\nif (!paymentAmount || paymentAmount <= 0) {\n  throw new Error('Missing or invalid payment amount');\n}\nif (!paymentId) {\n  throw new Error('Missing payment ID — required for idempotency');\n}\n\nreturn [{\n  json: {\n    contactId,\n    contactEmail,\n    paymentAmount: parseFloat(paymentAmount),\n    paymentId: String(paymentId),\n    artistName,\n    appointmentDate,\n    rawPayload: body\n  }\n}];"
      },
      "id": "validate-payload",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "vQc7pV2wjDImrvks",
          "mode": "id"
        },
        "options": {},
        "workflowInputs": {
          "values": [
            {
              "name": "email",
              "value": "={{ $json.contactEmail }}"
            },
            {
              "name": "firstName",
              "value": ""
            },
            {
              "name": "lastName",
              "value": ""
            },
            {
              "name": "phone",
              "value": ""
            }
          ]
        }
      },
      "id": "customer-matcher",
      "name": "Find/Create Customer",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-ls-id",
              "leftValue": "={{ ($json.lightspeed_customer_id || '').length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-ls-customer",
      "name": "Has LS Customer ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://trxtattoospiercings.retail.lightspeed.app/api/2.0/store_credits/{{ $('Find/Create Customer').item.json.lightspeed_customer_id }}/transactions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"store_credit_customer_id\": \"{{ $('Find/Create Customer').item.json.lightspeed_customer_id }}\",\n  \"amount\": {{ $('Validate Payload').item.json.paymentAmount }},\n  \"type\": \"ISSUE\",\n  \"notes\": \"Deposit via booking — {{ $('Validate Payload').item.json.artistName }} {{ $('Validate Payload').item.json.appointmentDate }}\",\n  \"user_id\": \"0ac54c19-8c55-11ed-f913-3dd92e9d5935\",\n  \"client_id\": \"{{ $('Validate Payload').item.json.paymentId }}\"\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "issue-store-credit",
      "name": "Issue Store Credit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "rwkPiSgkd7mzdn83",
          "name": "Lightspeed TRX"
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
