    {
      "parameters": {
        "jsCode": "// Generate HTML from submission data for PDF conversion\nconst sub = $json.submissionData;\nconst others = sub.others || {};\n\nlet html = `\n<!DOCTYPE html>\n<html>\n<head><style>\n  body { font-family: Arial, sans-serif; margin: 40px; }\n  h1 { color: #333; border-bottom: 2px solid #333; padding-bottom: 10px; }\n  .field { margin: 10px 0; }\n  .label { font-weight: bold; color: #555; }\n  .value { margin-left: 10px; }\n  .footer { margin-top: 40px; font-size: 12px; color: #888; }\n</style></head>\n<body>\n  <h1>TRX Tattoos & Piercing — Consent Form</h1>\n  <p><strong>Form Type:</strong> ${$json.formType}</p>\n  <p><strong>Date:</strong> ${sub.createdAt || new Date().toISOString()}</p>\n  <hr>\n`;\n\nfor (const [key, value] of Object.entries(others)) {\n  html += `<div class=\"field\"><span class=\"label\">${key}:</span> <span class=\"value\">${value}</span></div>\\n`;\n}\n\nhtml += `\n  <div class=\"footer\">\n    <p>Archived by TRX automated system. Submission ID: ${sub.id}</p>\n    <p>Missouri 2-year retention requirement — do not delete before retention period expires.</p>\n  </div>\n</body>\n</html>`;\n\nreturn [{ json: { ...$json, html, binary: null } }];"
      },
      "id": "generate-html",
      "name": "Generate HTML for PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -60
      ]
    },
    {
      "parameters": {
        "operation": "toFile",
        "options": {},
        "sourceProperty": "html",
        "fileName": "={{ $json.fileName }}",
        "mimeType": "text/html"
      },
      "id": "convert-to-file",
      "name": "Convert to File",
      "type": "n8n-nodes-base.convertToFile",
