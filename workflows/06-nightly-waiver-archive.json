    {
      "parameters": {
        "jsCode": "// Build today's date and folder path\nconst now = new Date();\nconst year = now.getFullYear();\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst day = String(now.getDate()).padStart(2, '0');\nconst today = `${year}-${month}-${day}`;\n\n// For fetching submissions from the past day\nconst yesterday = new Date(now);\nyesterday.setDate(yesterday.getDate() - 1);\n\nreturn [{\n  json: {\n    today,\n    year: String(year),\n    month,\n    folderPath: `TRX-Waivers/${year}/${month}`,\n    startDate: yesterday.toISOString(),\n    endDate: now.toISOString()\n  }\n}];"
      },
      "id": "build-date",
      "name": "Build Date & Folder Path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://services.leadconnectorhq.com/forms/submissions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "locationId",
              "value": "={{ n3G3ccCrPjsSH9bGlfIQ }}"
            },
            {
              "name": "startAt",
              "value": "={{ $json.startDate }}"
            },
            {
              "name": "endAt",
              "value": "={{ $json.endDate }}"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        }
      },
      "id": "fetch-submissions",
      "name": "Fetch Today's Form Submissions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "AcpfpX2vSAGlSAfK",
          "name": "GHL TRX"
        }
      },
      "continueOnFail": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Filter for consent/waiver forms and prepare for PDF generation\nconst submissions = $json.submissions || [];\nconst dateInfo = $('Build Date & Folder Path').first().json;\n\n// Filter for tattoo and piercing consent forms\n// IMPORTANT: Replace these form IDs with actual GHL form IDs\nconst consentFormIds = [\n  'TATTOO_CONSENT_FORM_ID',   // Replace with actual tattoo consent form ID\n  'PIERCING_CONSENT_FORM_ID'  // Replace with actual piercing consent form ID\n];\n\nconst waiverSubmissions = submissions.filter(sub => {\n  // If form IDs are configured, filter by them\n  // Otherwise, include all (user needs to set IDs)\n  if (consentFormIds[0] !== 'TATTOO_CONSENT_FORM_ID') {\n    return consentFormIds.includes(sub.formId);\n  }\n  return true; // Include all until form IDs are configured\n});\n\nif (waiverSubmissions.length === 0) {\n  return [{ json: { noSubmissions: true, count: 0, folderPath: dateInfo.folderPath } }];\n}\n\nreturn waiverSubmissions.map(sub => {\n  const lastName = sub.others?.lastName || sub.others?.last_name || sub.contactId || 'unknown';\n  const formType = sub.formId === consentFormIds[0] ? 'tattoo-consent' : 'piercing-consent';\n  const fileName = `${dateInfo.today}_${lastName}_${formType}.pdf`;\n\n  return {\n    json: {\n      submissionId: sub.id,\n      formId: sub.formId,\n      contactId: sub.contactId,\n      lastName,\n      formType,\n      fileName,\n      folderPath: dateInfo.folderPath,\n      submissionData: sub,\n      noSubmissions: false\n    }\n  };\n});"
      },
      "id": "filter-consent-forms",
      "name": "Filter Consent Forms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-submissions",
              "leftValue": "={{ $json.noSubmissions }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-submissions",
      "name": "Has Submissions?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
