    {
      "parameters": {
        "jsCode": "// Map GHL artist name to Lightspeed employee ID\n// IMPORTANT: Update this mapping with actual Lightspeed employee IDs from client\nconst artistMap = {\n  // 'Artist Name in GHL Calendar': 'lightspeed_employee_uuid'\n  // Example entries — replace with real values:\n  // 'Jake': 'employee-uuid-1',\n  // 'Honeybee': 'employee-uuid-2',\n};\n\nconst sale = $json.data[0];\nconst artistName = $('Validate & Extract').first().json.artistName;\nconst mappedEmployeeId = artistMap[artistName] || null;\n\nconst currentEmployeeId = sale.user_id || null;\nconst needsUpdate = mappedEmployeeId && mappedEmployeeId !== currentEmployeeId;\n\nreturn [{\n  json: {\n    saleId: sale.id,\n    currentEmployeeId,\n    mappedEmployeeId,\n    artistName,\n    needsUpdate,\n    contactEmail: $('Validate & Extract').first().json.contactEmail\n  }\n}];"
      },
