    {
      "parameters": {
        "jsCode": "// Extract appointment data and validate status\nconst body = $json.body || $json;\nconst status = (body.status || body.appointmentStatus || '').toLowerCase();\n\nif (status !== 'showed' && status !== 'completed') {\n  return []; // Skip — not a completion event\n}\n\nconst contactEmail = body.contact_email || body.email || (body.contact && body.contact.email);\nconst artistName = body.calendarName || body.assigned_user_name || body.artist_name || '';\nconst appointmentId = body.id || body.appointment_id;\nconst appointmentDate = body.startTime || body.appointment_date || new Date().toISOString().split('T')[0];\n\nif (!contactEmail) {\n  throw new Error('Missing contact email in appointment webhook');\n}\n\nreturn [{\n  json: {\n    contactEmail,\n    artistName,\n    appointmentId,\n    appointmentDate: appointmentDate.split('T')[0],\n    status\n  }\n}];"
      },
      "id": "validate-extract",
      "name": "Validate & Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
