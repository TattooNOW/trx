{
  "name": "WF5 — Nightly Reconciliation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 23 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Night at 11:30 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Build today's date range\nconst now = new Date();\nconst year = now.getFullYear();\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst day = String(now.getDate()).padStart(2, '0');\nconst today = `${year}-${month}-${day}`;\n\nreturn [{\n  json: {\n    dateFrom: today,\n    dateTo: today,\n    today\n  }\n}];"
      },
      "id": "build-date",
      "name": "Build Today's Date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LS_BASE_URL }}/api/2.0/sales",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "CLOSED"
            },
            {
              "name": "date_from",
              "value": "={{ $json.dateFrom }}"
            },
            {
              "name": "date_to",
              "value": "={{ $json.dateTo }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-today-sales",
      "name": "Fetch Today's Closed Sales",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "lightspeed-token",
          "name": "Lightspeed Personal Token"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Split sales into individual items for processing\nconst sales = $json.data || [];\nconst today = $('Build Today\\'s Date').first().json.today;\n\nif (sales.length === 0) {\n  return [{ json: { noSales: true, today, summary: 'No sales found today' } }];\n}\n\nreturn sales.map(sale => ({\n  json: {\n    saleId: sale.id,\n    customerEmail: sale.customer_email || (sale.customer && sale.customer.email) || '',\n    customerFirstName: sale.customer_first_name || (sale.customer && sale.customer.first_name) || '',\n    customerLastName: sale.customer_last_name || (sale.customer && sale.customer.last_name) || '',\n    saleTotal: parseFloat(sale.total_inc_tax || sale.total || 0),\n    saleDate: today,\n    employeeId: sale.user_id || '',\n    lineItems: sale.line_items || sale.register_sale_products || [],\n    noSales: false\n  }\n}));"
      },
      "id": "split-sales",
      "name": "Split Sales Into Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-sales",
              "leftValue": "={{ $json.noSales }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "has-email",
              "leftValue": "={{ $json.customerEmail }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-email",
      "name": "Has Customer Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "locationId",
              "value": "={{ $env.GHL_LOCATION_ID }}"
            },
            {
              "name": "query",
              "value": "={{ $json.customerEmail }}"
            }
          ]
        },
        "options": {}
      },
      "id": "search-ghl",
      "name": "Search GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -60],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ghl-pit-token",
          "name": "GHL PIT Token"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Check if contact needs sync (missing tag or wrong date)\nconst contacts = $json.contacts || [];\nconst saleData = $('Has Customer Email?').first().json;\nconst today = saleData.saleDate;\n\nlet needsSync = false;\nlet contactId = null;\nlet reason = '';\n\nif (contacts.length === 0) {\n  needsSync = true;\n  reason = 'Contact not found in GHL';\n} else {\n  const contact = contacts[0];\n  contactId = contact.id;\n  const tags = contact.tags || [];\n  const customFields = contact.customFields || contact.customField || [];\n\n  const hasTag = tags.includes('lightspeed-customer');\n  const saleDateField = customFields.find(f => f.key === 'last_lightspeed_sale_date' || f.id === 'last_lightspeed_sale_date');\n  const hasCorrectDate = saleDateField && saleDateField.value === today;\n\n  if (!hasTag || !hasCorrectDate) {\n    needsSync = true;\n    reason = !hasTag ? 'Missing lightspeed-customer tag' : 'Sale date not updated';\n  }\n}\n\nreturn [{\n  json: {\n    ...saleData,\n    needsSync,\n    contactId,\n    reason\n  }\n}];"
      },
      "id": "check-sync-status",
      "name": "Check Sync Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -60]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "needs-sync",
              "leftValue": "={{ $json.needsSync }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-sync",
      "name": "Needs Sync?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1540, -60]
    },
    {
      "parameters": {
        "workflowId": "={{ /* Set to Customer Matcher workflow ID after import */ '' }}",
        "options": {},
        "workflowInputs": {
          "values": [
            {
              "name": "email",
              "value": "={{ $json.customerEmail }}"
            },
            {
              "name": "firstName",
              "value": "={{ $json.customerFirstName }}"
            },
            {
              "name": "lastName",
              "value": "={{ $json.customerLastName }}"
            },
            {
              "name": "phone",
              "value": ""
            }
          ]
        }
      },
      "id": "ensure-contact",
      "name": "Ensure GHL Contact Exists",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1760, -120]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $json.ghl_contact_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"customFields\": [\n    { \"key\": \"last_lightspeed_sale_date\", \"field_value\": \"{{ $('Check Sync Status').first().json.saleDate }}\" },\n    { \"key\": \"last_lightspeed_sale_amount\", \"field_value\": \"{{ $('Check Sync Status').first().json.saleTotal }}\" }\n  ]\n}",
        "options": {}
      },
      "id": "update-contact",
      "name": "Update GHL Contact Fields",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, -120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ghl-pit-token",
          "name": "GHL PIT Token"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "workflowId": "={{ /* Set to Tag Applier workflow ID after import */ '' }}",
        "options": {},
        "workflowInputs": {
          "values": [
            {
              "name": "contactId",
              "value": "={{ $('Ensure GHL Contact Exists').first().json.ghl_contact_id }}"
            },
            {
              "name": "tags",
              "value": "={{ ['lightspeed-customer'] }}"
            }
          ]
        }
      },
      "id": "apply-tag",
      "name": "Apply lightspeed-customer Tag",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1980, 0]
    },
    {
      "parameters": {},
      "id": "already-synced",
      "name": "Already Synced",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1760, 0]
    },
    {
      "parameters": {},
      "id": "skip-no-email",
      "name": "Skip (No Email)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1100, 120]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.OPS_EMAIL }}",
        "toEmail": "={{ $env.OPS_EMAIL }}",
        "subject": "TRX Nightly Reconciliation Summary",
        "emailType": "text",
        "message": "=Nightly reconciliation complete.\n\nCheck n8n execution log for details."
      },
      "id": "send-summary",
      "name": "Send Summary Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2200, -60],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Every Night at 11:30 PM": {
      "main": [
        [{ "node": "Build Today's Date", "type": "main", "index": 0 }]
      ]
    },
    "Build Today's Date": {
      "main": [
        [{ "node": "Fetch Today's Closed Sales", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Today's Closed Sales": {
      "main": [
        [{ "node": "Split Sales Into Items", "type": "main", "index": 0 }]
      ]
    },
    "Split Sales Into Items": {
      "main": [
        [{ "node": "Has Customer Email?", "type": "main", "index": 0 }]
      ]
    },
    "Has Customer Email?": {
      "main": [
        [{ "node": "Search GHL Contact", "type": "main", "index": 0 }],
        [{ "node": "Skip (No Email)", "type": "main", "index": 0 }]
      ]
    },
    "Search GHL Contact": {
